#include "resource.h"

IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New", IDM_FILE_NEW
        MENUITEM "&Open...", IDM_FILE_OPEN
        MENUITEM "&Save", IDM_FILE_SAVE, GRAYED
        MENUITEM "Save &as...", IDM_FILE_SAVE_AS
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Font...", IDM_VIEW_FONT
    END
END